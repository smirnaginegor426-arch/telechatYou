# MySQL/TiDB Cloud connection URL; URL-encode special characters in the password.
DATABASE_URL=mysql://USERNAME:URL_ENCODED_PASSWORD@HOST:4000/telechatyou

# Random secret >= 32 characters. Required in production.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Local development file storage (temporary on Render Free).
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20
PORT=3000

# Optional persistent S3-compatible storage. Recommended for Render Free + Cloudflare R2.
# Set all four values together in the host's secret environment settings.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
