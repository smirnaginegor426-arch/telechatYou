# MySQL/TiDB Cloud connection URL; URL-encode special characters in the password.
DATABASE_URL=mysql://USERNAME:URL_ENCODED_PASSWORD@HOST:4000/telechatyou

# Random secret >= 32 characters. Required in production.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Local development file storage (temporary on Render Free).
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20
PORT=3000

# Recommended persistent media storage for Render Free.
# Preferred: copy the complete API environment variable from Cloudinary Console → Settings → API Keys.
# Put it in Render as CLOUDINARY_URL. Do not publish it; it includes the API secret.
CLOUDINARY_URL=
# Alternative: if not using CLOUDINARY_URL, set all three values together.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional alternative S3-compatible storage, if you already have a provider configured.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Transactional email for account email verification and password recovery.
# Create a Resend API key and configure a verified sender address.
RESEND_API_KEY=
EMAIL_FROM=TeleChatYou <no-reply@example.com>
